{
  "name": "@counterpick/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Counterpick desktop companion for Dota 2",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:shell": "tsc --noEmit -p tsconfig.shell.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.83.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gsap": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.6"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10"
  }
}
