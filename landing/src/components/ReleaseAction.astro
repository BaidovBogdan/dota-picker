---
type Props = {
  class?: string;
  compact?: boolean;
  href: string;
  label: string;
};

const {
  class: className = "",
  compact = false,
  href,
  label
} = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class={className}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 3v11m0 0 4-4m-4 4-4-4M5 16v3h14v-3" />
  </svg>
  <span>{label}</span>
  {compact && <span class="release-action__compact">Get the app</span>}
</a>
