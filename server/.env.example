NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://dota_picker:dota_picker@localhost:5432/dota_picker
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false
LOG_LEVEL=info
FREE_QUOTA_MAX=3
FREE_QUOTA_REFILL_AMOUNT=1
FREE_QUOTA_REFILL_HOURS=24
PRO_QUOTA_MAX=100
PRO_QUOTA_REFILL_AMOUNT=100
PRO_QUOTA_REFILL_HOURS=24
OPEN_DOTA_BASE_URL=https://api.opendota.com/api
OPEN_DOTA_TIMEOUT_MS=8000
META_CACHE_TTL_SECONDS=900
META_CACHE_STALE_SECONDS=86400
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
MAX_IMAGE_BYTES=5242880
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=300
REVENUECAT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_APP_IDS=
REVENUECAT_ALLOW_SANDBOX=true
